{
  "manifest_version": 3,
  "name": "Claude Address Bar Search",
  "version": "0.1.4",
  "description": "Route Safari address-bar searches to the signed-in Claude session.",
  "permissions": [
    "webRequest"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "scripts": [
      "search.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/new*"
      ],
      "js": [
        "claude.js"
      ],
      "run_at": "document_start"
    }
  ]
}
