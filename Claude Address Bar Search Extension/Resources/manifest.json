{
  "manifest_version": 3,
  "name": "Claude Address Bar Search",
  "version": "0.1.6",
  "description": "Search with Claude or Google Images from Safari.",
  "action": {
    "default_title": "Search Google Images",
    "default_popup": "popup.html"
  },
  "permissions": [
    "webRequest"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "scripts": [
      "search.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/new*"
      ],
      "js": [
        "claude.js"
      ],
      "run_at": "document_start"
    }
  ]
}
